<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <insead_checkout>
            <insead_customcheckout>
                <!-- Off by default; enable per website / store view as needed. -->
                <enabled>0</enabled>
                <!-- Hidden by default for both profiles; add b2c and/or b2b
                     per website / store view to show. -->
                <show_gender_field></show_gender_field>
                <show_nationality_field></show_nationality_field>
                <show_phone_field></show_phone_field>
                <!-- Matches current behavior out of the box: required for
                     Self-funded (B2C) only. Add b2b per website / store view
                     to also require it for Sponsored by Organisation. Has no
                     effect for a profile where show_phone_field above doesn't
                     include it — a hidden field is never required.
                -->
                <phone_required>b2c</phone_required>
                <!-- Hidden by default (mandatory Tax & Legal fields + PO
                     Number always show regardless of this setting; only
                     these optional ones are affected). Add duns, routing,
                     taxreg, cert_opt, and/or reg_type per website / store
                     view to show any of them. -->
                <show_optional_tax_fields></show_optional_tax_fields>
                <!-- Organisation Details fields — B2B only, so a single
                     Yes/No per field rather than the B2C/B2B multiselect
                     pattern used above (there's no B2C equivalent for any
                     of these three). Defaults match current behavior:
                     all shown; Commercial Company Name optional,
                     Organisation Type and Job Industry required. -->
                <show_commercial_company_name>1</show_commercial_company_name>
                <commercial_company_name_required>0</commercial_company_name_required>
                <show_organization_type>1</show_organization_type>
                <organization_type_required>1</organization_type_required>
                <show_job_industry>1</show_job_industry>
                <job_industry_required>1</job_industry_required>
            </insead_customcheckout>
            <insee_lookup>
                <!-- Off by default until an API key is configured. -->
                <enabled>0</enabled>
                <api_base_url>https://api.insee.fr/api-sirene/3.11</api_base_url>
            </insee_lookup>
            <!--
                Which customer group to assign for non-Singapore stores
                (icp_fra/lhub_fra/icp_usa etc.) — see
                Model\Vat\CustomerGroupResolver. By explicit decision, this
                now uses the SAME shape as Singapore GST: only
                `financing_profile` (B2C/B2B) and `tax_registration_status`
                (Registered/Non-Registered/Exempt), both self-declared on the
                frontend — NOT EU-vs-non-EU country, VIES VAT-number
                validity, or a supporting "letter" document, which the
                previous 6-group design used. See CustomerGroupResolver's
                docblock for the compliance note this tradeoff carries.
                No numeric ID defaults below — same reasoning as gst_group:
                a made-up placeholder ID that doesn't match a real group on
                a given instance previously caused a production crash. Each
                of the 4 MUST be explicitly selected from the dropdown in
                Admin > Stores > Configuration, per store.
            -->
            <vat_group>
                <!-- <b2c>REPLACE_ME</b2c> -->
                <!-- <b2b_registered>REPLACE_ME</b2b_registered> -->
                <!-- <b2b_non_registered>REPLACE_ME</b2b_non_registered> -->
                <!-- <b2b_tax_exempt>REPLACE_ME</b2b_tax_exempt> -->
            </vat_group>
            <!--
                Singapore GST — see Model\Gst\CustomerGroupResolver /
                Observer\Gst\SetQuoteCustomerGroup / Block\Checkout. `enabled`
                is the SINGLE admin flag that governs GST end to end: whether
                the GST Declaration / residency declaration fields render on
                the frontend at all, AND whether the backend group assignment
                runs (GST itself is then calculated by native Tax Rules keyed
                to each group's Tax Class — no custom total). Off by default
                everywhere; enable per store/website ONLY for the Singapore
                selling-entity store(s) (e.g. lhub_sgp).
                The 6 groups (B2C, B2C_SG_GST_LIABLE, B2B_REGISTERED,
                B2B_NON_REGISTERED, B2B_TAX_EXEMPT, B2B_SG_GST_LIABLE) have NO
                numeric ID defaults below — each must be explicitly created
                and selected in admin; see the comment inside <gst_group> for
                why.
            -->
            <gst_group>
                <enabled>0</enabled>
                <!--
                    All 6 group IDs are deliberately left UNSET here — no
                    numeric defaults. A made-up placeholder ID that doesn't
                    match a real group on a given instance is exactly what
                    caused a production crash before (Magento's tax
                    collector throwing "No such entity with id = N" while
                    resolving a nonexistent customer group's tax class).
                    CustomerGroupResolver::resolve() returns null when a path
                    isn't configured, and SetQuoteCustomerGroup safely no-ops
                    on null — so an unconfigured store just does nothing,
                    rather than crashing or misassigning. Each of the 6 MUST
                    be explicitly selected from the dropdown in Admin >
                    Stores > Configuration, at the scope of the Singapore
                    selling-entity store(s) (e.g. lhub_sgp), after the
                    matching groups + Tax Classes + Tax Rules are created —
                    see Model\Gst\CustomerGroupResolver's docblock for the
                    6-group table this maps to.
                -->
                <!-- <b2c>REPLACE_ME</b2c> -->
                <!-- <b2c_sg_gst_liable>REPLACE_ME</b2c_sg_gst_liable> -->
                <!-- <b2b_registered>REPLACE_ME</b2b_registered> -->
                <!-- <b2b_non_registered>REPLACE_ME</b2b_non_registered> -->
                <!-- <b2b_tax_exempt>REPLACE_ME</b2b_tax_exempt> -->
                <!-- <b2b_sg_gst_liable>REPLACE_ME</b2b_sg_gst_liable> -->
                <!--
                    Which GST Declaration statement value(s) (see
                    billing-form.js's gstStatements / Model\Gst\Source\DeclarationOptions)
                    move a B2B customer into B2B_SG_GST_LIABLE. Comma-separated.
                    Only statement 4 ("None of the above apply") — its own
                    form text states selecting it results in a Singapore-GST
                    invoice; statements 1-3 do not.
                -->
                <b2b_applicable_declarations>4</b2b_applicable_declarations>
            </gst_group>
        </insead_checkout>
    </default>
</config>