<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <!--
        Global (not area-scoped) because order placement can happen from
        frontend checkout, admin order creation, or the REST/GraphQL APIs —
        the DataHub export should run regardless of which one placed it.
    -->
    <event name="checkout_submit_all_after">
        <observer name="insead_export_mg_organization"
                  instance="Insead\CustomCheckout\Observer\ExportOrganizationOnOrderPlaced"/>
    </event>
    <!--
        VAT-based customer group assignment for tax calculation — see
        Observer\Vat\SetQuoteCustomerGroup for the coexistence rationale
        (only acts on quotes that went through this module's own checkout).
    -->
    <event name="sales_quote_address_collect_totals_before">
        <observer name="insead_set_vat_customer_group"
                  instance="Insead\CustomCheckout\Observer\Vat\SetQuoteCustomerGroup"/>
    </event>
    <event name="sales_quote_address_collect_totals_after">
        <observer name="insead_restore_vat_customer_group"
                  instance="Insead\CustomCheckout\Observer\Vat\RestoreQuoteCustomerGroup"/>
    </event>
</config>
